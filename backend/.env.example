# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/dental_clinic_db?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ============================================
# EMAIL CONFIGURATION (Brevo API)
# ============================================
# Get your Brevo API key from: https://app.brevo.com/settings/keys
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="your-verified-email@example.com"
EMAIL_FROM_NAME="Brilliant Dental Clinic"
ENABLE_EMAIL_NOTIFICATIONS="true" # Set to "true" to enable email notifications

# ============================================
# WHATSAPP CONFIGURATION (Kapso)
# ============================================
# Get your Kapso API key from: https://app.kapso.ai/settings/api
KAPSO_API_KEY="241d59f7827c2ec2552976d0607e5ac762c80aeb7dfa04b893786f34a008418a"
WHATSAPP_PHONE_NUMBER_ID="597907523413541"
ENABLE_WHATSAPP_NOTIFICATIONS="true" # Set to "true" to enable WhatsApp notifications

# Webhook Configuration (for receiving messages)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token"
META_APP_SECRET="your_meta_app_secret" # Optional: for webhook signature verification

