# Notification Timing Settings
EMAIL_APPOINTMENT_REMINDER_HOURS=24 # Send email reminder X hours before appointment
CLINIC_TIMEZONE="America/Montevideo" # Timezone for displaying appointment times in emails (e.g., America/New_York, Europe/London)

# File Upload Configuration
# UPLOAD_DIR="./uploads"
# MAX_FILE_SIZE=10485760 # 10MB in bytes

# ============================================
# CHATBOT & AI CONFIGURATION (Gemini)
# ============================================
# Get your Gemini API key from Google AI Studio
GEMINI_API_KEY="your-gemini-api-key"
AI_MODEL="gemini-2.0-flash-exp"
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
APP_LANGUAGE="es" # Set to "en" for English, "es" for Spanish


# Redis Configuration (for future Bull queue)
# REDIS_URL="redis://localhost:6379"

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values
# 3. For Email:
#    - Use your Gmail account and generate an App Password
#    - Set SMTP_USER to your Gmail and SMTP_PASS to the App Password
#    - Set ENABLE_EMAIL_NOTIFICATIONS="true"
# 4. For Calendar / Push Notifications:
# - Go to Google Cloud Console, enable Calendar API
# - Create a Service Account and download the JSON key
# - Set GOOGLE_CLIENT_EMAIL and GOOGLE_PRIVATE_KEY from the JSON
# 5. For WhatsApp Integration (Kapso):
# - Sign up at https://kapso.ai and get your API key
# - Connect your WhatsApp Business Account
# - Get your Phone Number ID from Meta Business Manager
# - Create message templates in Meta Business Manager and get them approved
# - Set KAPSO_API_KEY, WHATSAPP_PHONE_NUMBER_ID
# - Set ENABLE_WHATSAPP_NOTIFICATIONS="true"
# - Configure webhook URL in Kapso: https://your-domain.com/api/v1/whatsapp/webhook
# 6. Restart the backend server
